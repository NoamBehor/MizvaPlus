EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Development-only Supabase test account (local dev / dev client builds only).
# Loaded via app.config.js extra — never use EXPO_PUBLIC_* for credentials.
# Not required for production builds.
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=

# Android Google Maps API key (build-time only — NOT in JS bundle).
# Injected via app.config.js react-native-maps plugin into AndroidManifest on EAS/prebuild.
# Enable "Maps SDK for Android" in Google Cloud. Restrict the key to package
# com.mitzvahapp.app plus BOTH the debug keystore SHA-1 and Play App Signing SHA-1.
# Debug SHA-1: keytool -list -v -keystore android/app/debug.keystore -alias androiddebugkey
# Rebuild the native binary after changing this key. A JS reload will not update tiles.
# EAS: eas env:create --name GOOGLE_MAPS_ANDROID_API_KEY --value <key> --environment production
GOOGLE_MAPS_ANDROID_API_KEY=

# Web Google Maps JavaScript API key (browser only — EXPO_PUBLIC_* is bundled for web).
# Restrict in Google Cloud Console with HTTP referrer restrictions for your web origin(s).
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Supabase Dashboard > Auth > URL Configuration — add redirect allowlist:
# - mitzvahapp://reset-password
# - mitzvahapp://confirm

# Public Play listing contact (not sensitive). Required for the privacy policy.
PLAY_SUPPORT_EMAIL=

# Public HTTPS URLs after the legal pages are hosted.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
